Dim peso As Integer                         'peso do usuario'
Input peso                                  'digitar valor do peso'
Dim recomendado as Integer = peso * 35      'calcular meta recomendada'
Dim agua As Integer                         'quantidade de agua que o usuario bebe, em ml'
