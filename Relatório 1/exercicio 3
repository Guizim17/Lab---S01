DIM TEMPO AS INTEGER                    'variavel do tempo'
INPUT TEMPO                             'digitar tempo em horas'
DIM MINUTOS AS INTEGER = TEMPO * 60     'converter para minutos'
DIM SEGUNDOS AS INTEGER = MINUTOS * 60  'converter para segundos'
PRINT "Tempo em horas: ", TEMPO         'imprimir tempo original'
PRINT "Tempo em minutos: ", MINUTOS     'imprimir em minutos'
PRINT "Tempo em segundos: ", SEGUNDOS   'imprimir em segundos'
SLEEP
